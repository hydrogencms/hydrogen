.work/
.DS_Store
/bin/
# go build ./cmd/hydrogen at the root writes the CLI here (the release script builds into bin/)
/hydrogen
node_modules/
*.test
coverage.out
planning/
/packages/*/dist/
# The built admin is not committed on main: `make admin` builds it, the release workflow records it in release commits
/admin/dist/*
!/admin/dist/.keep
/packages/node_modules/
# Local media storage of example projects (media.storage.dir, default data/media)
examples/*/data/

# Binaries built inside example projects (go build in their directory)
/examples/headless/headless
/examples/minimal/minimal
