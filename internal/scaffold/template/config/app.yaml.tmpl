http:
  addr: ${env:LISTEN_ADDR:-:8080}

database:
  # sqlite:<path> (no setup) or postgres://user:pass@host:5432/db
  url: ${env:DATABASE_URL:-sqlite:.work/hydrogen.db}

manage:
  # Optional bearer token with every right, for automation and bootstrapping; dev-token in dev when unset.
  # Remove it to let only users (hydrogen users:create-admin) and API tokens (hydrogen tokens:create) sign in.
  token: ${env:MANAGE_TOKEN:-dev-token}

# Management sessions; the defaults are shown. Cookies are Secure unless insecure_cookies (dev only).
# auth:
#   session_idle: 12h
#   session_max: 168h
#   insecure_cookies: false
# http.trusted_proxies (CIDRs of your reverse proxies) makes login throttling see real client addresses.

delivery:
  # Signs preview tokens: at least 32 characters; required outside dev (dev derives it from manage.token).
  preview_secret: ${env:PREVIEW_SECRET:-}
