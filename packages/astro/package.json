{
  "name": "@hydrogencms/astro",
  "version": "0.2.1",
  "description": "Astro adapter for Hydrogen: integration, route-resolving middleware, preview, revalidation and block components",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./middleware": "./dist/middleware.js",
    "./routes/preview": "./dist/routes/preview.js",
    "./routes/revalidate": "./dist/routes/revalidate.js",
    "./routes/bridge": "./dist/routes/bridge.js",
    "./components/*": "./components/*",
    "./env": "./env.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "components",
    "env.d.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/hydrogencms/hydrogen.git", "directory": "packages/astro" },
  "homepage": "https://github.com/hydrogencms/hydrogen#readme",
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@hydrogencms/bridge": "^0.2.1",
    "@hydrogencms/client": "^0.2.1",
    "@hydrogencms/router": "^0.2.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  }
}
