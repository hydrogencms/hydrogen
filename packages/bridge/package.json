{
  "name": "@hydrogencms/bridge",
  "version": "0.1.0",
  "description": "Preview bridge between the Hydrogen admin and a frontend in an iframe",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./merge": { "types": "./dist/merge.d.ts", "import": "./dist/merge.js" },
    "./iife": "./dist/bridge.iife.js",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "license": "MIT",
  "devDependencies": { "happy-dom": "^21.0.1" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/iife.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
