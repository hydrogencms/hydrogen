{
  "name": "@hydrogencms/client",
  "version": "0.1.0",
  "description": "Typed client for the Hydrogen delivery API",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./package.json": "./package.json" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "test": "node --test test/*.test.mjs && npm run typecheck"
  }
}
