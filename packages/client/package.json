{
  "name": "@hydrogencms/client",
  "version": "0.1.0",
  "description": "Typed client for the Hydrogen delivery API",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./richtext": { "types": "./dist/richtext.d.ts", "import": "./dist/richtext.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/hydrogencms/hydrogen.git", "directory": "packages/client" },
  "homepage": "https://github.com/hydrogencms/hydrogen#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "test": "node --test test/*.test.mjs && npm run typecheck"
  }
}
