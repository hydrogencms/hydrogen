[
  {
    "name": "align on paragraph and heading; anything but the four values ignored",
    "doc": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "attrs": {
            "align": "center"
          },
          "content": [
            {
              "type": "text",
              "text": "a"
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "align": "right",
            "id": "top"
          },
          "content": [
            {
              "type": "text",
              "text": "T"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "align": "evil;color:red"
          },
          "content": [
            {
              "type": "text",
              "text": "x"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "align": "justify"
          },
          "content": [
            {
              "type": "text",
              "text": "j"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "align": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "l"
            }
          ]
        }
      ]
    },
    "html": "<p style=\"text-align:center\">a</p><h2 id=\"top\" style=\"text-align:right\">T</h2><p>x</p><p style=\"text-align:justify\">j</p><p style=\"text-align:left\">l</p>"
  },
