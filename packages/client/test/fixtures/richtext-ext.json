  {
    "name": "link target",
    "doc": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "go",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://x.test/",
                    "target": "_blank"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": "stay",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://x.test/",
                    "target": "_self"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "html": "<p><a href=\"https://x.test/\" target=\"_blank\" rel=\"noopener noreferrer\">go</a><a href=\"https://x.test/\">stay</a></p>"
  },
  {
