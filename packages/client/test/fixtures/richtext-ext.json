  {
    "name": "custom nodes and marks with a schema",
    "options": {
      "schema": {
        "nodes": {
          "callout": {
            "tag": "aside",
            "attrs": {
              "variant": {
                "type": "enum",
                "default": "info"
              },
              "dismissible": {
                "type": "bool"
              }
            }
          },
          "details": {
            "tag": "details"
          },
          "detailsSummary": {
            "tag": "summary"
          },
          "detailsBody": {},
          "embed": {
            "tag": "figure",
            "attrs": {
              "url": {
                "type": "url"
              },
              "caption": {
                "type": "string"
              }
            }
          },
          "footnoteRef": {
            "inline": true,
            "attrs": {
              "n": {
                "type": "int"
              }
            }
          }
        },
        "marks": {
          "highlight": {
            "tag": "mark",
            "attrs": {
              "tone": {
                "type": "enum"
              }
            }
          },
          "plain": {}
        }
      }
    },
    "doc": {
      "type": "doc",
      "content": [
        {
          "type": "callout",
          "attrs": {
            "dismissible": true
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "x"
                }
              ]
            }
          ]
        },
        {
          "type": "callout",
          "attrs": {
            "variant": "tip",
            "dismissible": false,
            "ghost": "no"
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "y"
                }
              ]
            }
          ]
        },
        {
          "type": "details",
          "attrs": {},
          "content": [
            {
              "type": "detailsSummary",
              "attrs": {},
              "content": [
                {
                  "type": "text",
                  "text": "Sum"
                }
              ]
            },
            {
              "type": "detailsBody",
              "attrs": {},
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Body"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "embed",
          "attrs": {
            "url": "https://v.test/a?b=1&c=2",
            "caption": "a & \"b\" <c>"
          },
          "content": []
        },
        {
          "type": "embed",
          "attrs": {
            "url": "javascript:alert(1)",
            "caption": "x"
          },
          "content": []
        },
        {
          "type": "embed",
          "attrs": {
            "url": "//evil.test/x"
          },
          "content": []
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "n"
            },
            {
              "type": "footnoteRef",
              "attrs": {
                "n": 12
              }
            },
            {
              "type": "text",
              "text": "h",
              "marks": [
                {
                  "type": "highlight",
                  "attrs": {
                    "tone": "green"
