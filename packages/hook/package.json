{
  "name": "@hydrogencms/hook",
  "version": "0.3.0",
  "description": "Write Hydrogen WebAssembly hooks in TypeScript (compiled with Javy)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./package.json": "./package.json" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/hydrogencms/hydrogen.git", "directory": "packages/hook" },
  "homepage": "https://github.com/hydrogencms/hydrogen#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "test": "node --test test/*.test.mjs && npm run typecheck"
  }
}
