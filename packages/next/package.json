{
  "name": "@hydrogencms/next",
  "version": "0.3.0",
  "description": "Next.js App Router adapter for Hydrogen",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js"
    },
    "./package.json": "./package.json",
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/hydrogencms/hydrogen.git", "directory": "packages/next" },
  "homepage": "https://github.com/hydrogencms/hydrogen#readme",
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@hydrogencms/bridge": "^0.3.0",
    "@hydrogencms/client": "^0.3.0",
    "@hydrogencms/router": "^0.3.0",
    "@hydrogencms/react": "^0.3.0"
  },
  "devDependencies": {
    "next": "^16.4.1",
    "react": "^19.0.0",
    "@types/react": "^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  }
}
