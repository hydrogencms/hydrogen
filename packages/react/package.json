{
  "name": "@hydrogencms/react",
  "version": "0.2.1",
  "description": "React blocks renderer, rich text and live preview for Hydrogen frontends",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/hydrogencms/hydrogen.git", "directory": "packages/react" },
  "homepage": "https://github.com/hydrogencms/hydrogen#readme",
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "dependencies": {
    "@hydrogencms/bridge": "^0.2.1",
    "@hydrogencms/client": "^0.2.1"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^21.0.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  }
}
