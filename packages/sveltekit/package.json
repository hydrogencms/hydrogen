{
  "name": "@hydrogencms/sveltekit",
  "version": "0.2.0",
  "description": "SvelteKit adapter for Hydrogen",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
          "import": "./dist/components.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/hydrogencms/hydrogen.git", "directory": "packages/sveltekit" },
  "homepage": "https://github.com/hydrogencms/hydrogen#readme",
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@hydrogencms/bridge": "^0.2.0",
    "@hydrogencms/client": "^0.2.0",
    "@hydrogencms/router": "^0.2.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.57.2",
    "vite": "^8.3.4"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "test": "node --test test/*.test.mjs"
  }
}
